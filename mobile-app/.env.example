# Backend API base URL (mobile app / capacitor web assets)
VITE_API_URL=http://localhost:2345/api

# How many minutes after a session starts before the first follow-up
# notification is sent ("counter" reminder), default 30.
VITE_COUNTER_NOTIFY_MINUTES=30

# FCM sender id (numeric) when using on-device push via @capacitor/push-notifications
VITE_FCM_SENDER_ID=